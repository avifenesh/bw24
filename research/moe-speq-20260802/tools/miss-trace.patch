+/// MEMRA_MOE_MISS_TRACE=<path>: append one line per SLRU dispatch — "<layer> <proj> <expert> <H|M>"
+/// — the per-lookup hit/miss log behind the MoE-SpeQ oracle-ceiling measurement (moe-speq lane,
+/// 2026-08-03). Unbuffered file writes so an aborted run keeps its tail. Diagnostic only: one
+/// OnceLock read when the flag is unset.
+fn miss_log(id: BlockId, hit: bool) {
+    use std::io::Write as _;
+    use std::sync::{Mutex, OnceLock};
+    static SINK: OnceLock<Option<Mutex<std::fs::File>>> = OnceLock::new();
+    let sink = SINK.get_or_init(|| {
+        std::env::var("MEMRA_MOE_MISS_TRACE").ok().and_then(|p| {
+            std::fs::OpenOptions::new().create(true).append(true).open(p).ok()
+        }).map(Mutex::new)
+    });
+    if let Some(m) = sink {
+        if let Ok(mut w) = m.lock() {
+            let _ = writeln!(w, "{} {} {} {}", id.layer, id.proj, id.ex,
+                             if hit { 'H' } else { 'M' });
+        }
+    }
+}
+
