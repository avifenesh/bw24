.version 8.8
.target sm_120a
.address_size 64
.visible .entry p(.param .u64 pmap)
{
    .shared .align 128 .b8 smem[256];
    .shared .align 8 .b8 bar[8];
    .reg .b64 %rd<4>;
    .reg .b32 %r<8>;
    ld.param.u64 %rd3, [pmap];
    mov.u64 %rd1, smem;
    mov.u64 %rd2, bar;
    mov.u32 %r1, 0;
    mov.u32 %r2, 0;
    cp.async.bulk.tensor.2d.shared::cta.global.tile.mbarrier::complete_tx::bytes [%rd1], [%rd3, {%r1, %r2}], [%rd2];
    ret;
}
