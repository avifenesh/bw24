.version 8.8
.target sm_120a
.address_size 64
.visible .entry probe_clc()
{
    .shared .align 16 .b8 res[16];
    .shared .align 8 .b8 bar[8];
    .reg .b64 %rd<3>;
    mov.u64 %rd1, res;
    mov.u64 %rd2, bar;
    cvta.shared.u64 %rd1, %rd1;
    cvta.shared.u64 %rd2, %rd2;
    clusterlaunchcontrol.try_cancel.async.shared::cta.mbarrier::complete_tx::bytes.b128 [%rd1], [%rd2];
    ret;
}
