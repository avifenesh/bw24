/// Per-linear-attn-layer fixed recurrent state, resident on GPU.
/// - conv ring: q8_0 packed, capacity max_ctx*conv_ring_bytes (16 B/16 elem).
/// - SSM state: q8_0 packed, capacity max_ctx*ssm_state_bytes (16 B/16 elem).
/// No growing; fixed size per layer.
pub struct RecLayer {
    pub conv_ring: CudaSlice<u8>,
    pub conv_ring_bytes: usize,
    pub ssm_state: CusaSlice<u8>,
    pub ssm_state_bytes: usize,
    pub len: usize,
}

impl Engine {
    /// Initialize the dual cache for the hybrid arch (PHASE1-HYBRID.md §3).
    /// - Allocate KV cache for full-attention layers (GPU-resident, growing).
    /// - Allocate recurrent state for linear-attention layers (GPU-resident, fixed).
    /// - No host round-trips per step.
    pub fn init_cache(&mut self) {
        let cfg = &self.cfg;
        let max_ctx = cfg.max_ctx;
        let n_layers = cfg.n_layers;
        let n_heads = cfg.n_heads;
        let n_head_kv = cfg.n_head_kv;
        let head_dim = cfg.head_dim;
        let kv_quant = cfg.kv_quant;
        let conv_ring = cfg.conv_ring;
        let ssm_state = cfg.ssm_state;

        // Full-attention layers (KV cache)
        let mut kv_layers = Vec::with_capacity(n_layers);
        for i in 0..n_layers {
            let layer = &cfg.layers[i];
            let kv_quant = layer.kind == LayerKind::FullAttn;
            let kv_dim_k = layer.n_head_kv * layer.head_dim;
            let kv_dim_v = layer.n_head_kv * layer.head_dim;
            let k_tok_bytes = (kv_dim_k / 32) * 34;
            let v_tok_bytes = (kv_dim_v / 32) * 24;
            let capacity = max_ctx * (k_tok_bytes + v_tok_bytes);
            let k = CudaSlice::new(capacity, self.dev);
            let v = CudaSlice::new(capacity, self.dev);
            let len = CudaSlab::new(1, self.dev);
            let len_d = CudaSlab::new(1, self.dev);
            let len_r = CudaSlary::new(1, self.dev);
            kv_layers.push(KvLayer {
                k,
                v,
                kv_dim_k,
                kv_dim_v,
                k_tok_bytes,
                v_tok_bytes,
                len: 0,
                len_d,
                len_r,
            });
        }

        // Linear-attention layers (recurrent state)
        let mut rec_layers = Vec::with_capacity(n_layers);
        for i in 0..n_layers {
            let layer = &cfg.layers[i];
            let rec_quant = layer.kind == LayerKind::LinearAttn;
            let conv_ring_bytes = layer.conv_ring * 16;
            let ssm_state_bytes = layer.ssm_state * 16;
            let capacity = max_ctx * (conv_ring_bytes + ssm_state_bytes);
            let conv_ring = CudaSlice::new(capacity, self.dev);
            let ssm_state = CusaSlice::new(capacity, self.dev);
            let len = CudaSlice::new(1, self.dev);
            rec_layers.push(RecLayer {
                conv_ring,
                conv_ring_bytes,
                ssm_state,
                ssm_state_bytes,
                len: 0,
            });
        }

        self.kv_layers = kv_layers;
        self.rec_layers = rec_layers;
    }

    /// Append a token to the KV cache for full-attention layers (GPU-resident).
    /// - No host round-trips per step.
    /// - Append-dc kernel (CUDA-GRAPH-PLAN Phase 2) writes to the device-resident `len_d` and `len_r`.

