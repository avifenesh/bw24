# Installed as /etc/memra/horde-worker.env with mode 0600.
# Obtain a permanent account key from https://aihorde.net/register.
AI_HORDE_API_KEY=replace-with-ai-horde-key

# Mint a dedicated memra key with a per-key concurrency cap of one.
MEMRA_HORDE_BACKEND_KEY=replace-with-memra-key

MEMRA_HORDE_WORKER_NAME=memra-research-preview-runpod
MEMRA_HORDE_SERVER_MODEL=stepfun/step-3.7-flash
MEMRA_HORDE_SERVER_URL=http://127.0.0.1:8002
MEMRA_HORDE_CLUSTER_URL=https://aihorde.net

# Conservative bridge-side caps. The memra admission stack remains authoritative.
MEMRA_HORDE_CONTEXT_TOKENS=16384
MEMRA_HORDE_MAX_OUTPUT_TOKENS=512
MEMRA_HORDE_THREADS=1
MEMRA_HORDE_TIMEOUT_SECONDS=300
MEMRA_HORDE_REFRESH_MILLISECONDS=5000
MEMRA_HORDE_NSFW=disabled
