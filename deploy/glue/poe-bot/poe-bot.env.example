# Poe verifies every protocol POST with this shared 32-character access key.
POE_ACCESS_KEY=replace-with-32-character-access-key

# Dedicated memra key, minted with a per-key concurrency cap of one.
MEMRA_POE_BACKEND_KEY=replace-with-memra-key

MEMRA_POE_BACKEND_URL=http://127.0.0.1:8002
MEMRA_POE_MODEL=stepfun/step-3.7-flash
MEMRA_POE_PATH=/poe

MEMRA_POE_MAX_INPUT_CHARS=60000
MEMRA_POE_MAX_MESSAGES=64
MEMRA_POE_MAX_OUTPUT_TOKENS=512
MEMRA_POE_MAX_CONCURRENCY=1
MEMRA_POE_QUEUE_WAIT_SECONDS=5
MEMRA_POE_BACKEND_TIMEOUT_SECONDS=300

MEMRA_POE_BIND=127.0.0.1
MEMRA_POE_PORT=8081
